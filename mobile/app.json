{
  "expo": {
    "name": "Clima Agora",
    "slug": "clima-agora",
    "description": "Previsão do tempo com localização, busca por cidade e temas dinâmicos.",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/clima-agora-icon.png",
    "scheme": "clima-agora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/clima-agora-icon.png"
    },
    "android": {
      "package": "app.climaagora",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B5164",
        "foregroundImage": "./assets/clima-agora-symbol.png",
        "monochromeImage": "./assets/clima-agora-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B5164",
          "image": "./assets/clima-agora-symbol.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que o Clima Agora use sua localização enquanto você usa o app.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
